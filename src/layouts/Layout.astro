---
import "../styles/global.css";
import CookieBanner from "../components/CookieBanner.astro";

interface Props {
  title: string;
  description?: string;
  image?: string; // para compartir en redes (Open Graph) — opcional
}

const {
  title,
  description = "Cremaçai (Cremacai): açaí, gelato artesanal, bowls y shakes en Barcelona. Visítanos en Carrer d'Aragó 303.",
  image = "/assets/hero-principal.jpg",
} = Astro.props;

// Astro.site viene de "site" en astro.config.mjs (cremacai.es). Con
// Astro.url.pathname armamos la URL completa y absoluta de ESTA página
// en concreto — la usamos tanto para el <link rel="canonical"> como
// para las etiquetas og:url. Así, sin importar por qué dominio entre
// alguien (aunque no debería, gracias a los redirects), Google siempre
// ve la misma URL canónica: cremacai.es.
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL(image, Astro.site);

// Datos estructurados (schema.org), en formato JSON-LD: un bloque de
// datos invisible para el usuario, pero que Google sí lee, para saber
// que esto es un negocio real: nombre, dirección, coordenadas, horario,
// redes sociales y dónde está el menú. Esto es justo lo que ayuda a que
// Google muestre la ficha correcta al buscar "cremacai" o "cremaçai".
const structuredData = {
  "@context": "https://schema.org",
  "@type": "IceCreamShop",
  "@id": "https://cremacai.es/#negocio",
  name: "Cremaçai",
  alternateName: ["Cremacai", "Cremaçaí"],
  description: "Açaí y gelato artesanal en Barcelona.",
  keywords:
    "açaí Barcelona, heladería Barcelona, gelato artesanal Barcelona, bowl de açaí",
  image: ogImageURL.toString(),
  url: "https://cremacai.es",
  telephone: "+34614554039",
  priceRange: "€€",
  servesCuisine: ["Açaí", "Gelato artesanal", "Sorbetes"],
  areaServed: {
    "@type": "City",
    name: "Barcelona",
  },
  address: {
    "@type": "PostalAddress",
    streetAddress: "Carrer d'Aragó, 303",
    addressLocality: "Barcelona",
    postalCode: "08009",
    addressRegion: "Catalunya",
    addressCountry: "ES",
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: 41.3948104,
    longitude: 2.1681261,
  },
  openingHoursSpecification: [
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
      opens: "10:30",
      closes: "23:00",
    },
    {
      "@type": "OpeningHoursSpecification",
      dayOfWeek: ["Saturday", "Sunday"],
      opens: "14:00",
      closes: "23:00",
    },
  ],
  menu: "https://cremacai.es/menu/",
  sameAs: ["https://www.instagram.com/cremacai/"],
};
---

<html lang="es">
  <head>
    <!-- Google Consent Mode v2 -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];

      function gtag() {
        window.dataLayer.push(arguments);
      }

      const savedConsent = localStorage.getItem("cremacai_cookie_consent");

      const consentGranted = savedConsent === "accepted";

      gtag("consent", "default", {
        ad_storage: consentGranted ? "granted" : "denied",
        analytics_storage: consentGranted ? "granted" : "denied",
        ad_user_data: consentGranted ? "granted" : "denied",
        ad_personalization: consentGranted ? "granted" : "denied",
        wait_for_update: 500,
      });
    </script>
    <!-- End Google Consent Mode v2 -->

    <!-- Google Tag Manager -->
    <script is:inline>
      (function (w, d, s, l, i) {
        w[l] = w[l] || [];
        w[l].push({
          "gtm.start": new Date().getTime(),
          event: "gtm.js",
        });

        var f = d.getElementsByTagName(s)[0],
          j = d.createElement(s),
          dl = l != "dataLayer" ? "&l=" + l : "";

        j.async = true;
        j.src = "https://www.googletagmanager.com/gtm.js?id=" + i + dl;

        f.parentNode.insertBefore(j, f);
      })(window, document, "script", "dataLayer", "GTM-NVVGPJMK");
    </script>
    <!-- End Google Tag Manager -->
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Baloo+2:wght@500;700;800&family=Poppins:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Open Graph: cómo se ve el enlace al compartirlo en WhatsApp, Instagram, Facebook... -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Cremaçai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:locale" content="es_ES" />
    <meta name="twitter:card" content="summary_large_image" />

    <!-- Datos estructurados: JSON.stringify convierte el objeto de arriba
		     en texto JSON, y set:html lo inserta tal cual (es contenido que
		     generamos nosotros mismos, no un usuario, así que es seguro). -->
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
      is:inline
    />
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript>
      <iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-NVVGPJMK"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe>
    </noscript>
    <!-- End Google Tag Manager (noscript) -->
    <slot />
    <CookieBanner />
  </body>
</html>
