---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import StoryBlockSection from "../components/StoryBlock.astro";
import FeaturedRecipe from "../components/FeaturedRecipe.astro";
import Location from "../components/Location.astro";
import Footer from "../components/Footer.astro";
import { storyBlocks, featuredRecipe, location } from "../data/site";
---

<Layout
	title="Nuestra Mezcla — Cremaçai | Historia del açaí y gelato artesanal en Barcelona"
	description="Conoce la historia de Cremaçai: inspirados por Brasil, enamorados de Italia, nacidos en Barcelona. Açaí y gelato artesanal hechos con pasión."
>
	<Header />

	<section class="mezcla-hero">
		<div class="wrap">
			<div class="copy">
				<h1>Nuestra Mezcla</h1>
				<div class="accent"></div>
				<p>La vida sabe mejor cuando se mezcla.</p>
			</div>
			<img src="/assets/producto-real.jpg" alt="Copaçaí cremaçai con chocolate, granola y flor comestible" />
		</div>
	</section>

	{storyBlocks.map((block) => <StoryBlockSection {...block} />)}

	<FeaturedRecipe {...featuredRecipe} />

	<section class="cta-banner">
		<div class="wrap">
			<h2>La vida sabe mejor cuando se mezcla.</h2>
			<p>Te esperamos en <strong>CREMAÇAÍ</strong>.</p>
		</div>
	</section>

	<Location info={location} />

	<Footer />
</Layout>

<style>
	.mezcla-hero{padding:44px 20px 40px;}
	.mezcla-hero .wrap{text-align:center;}
	.mezcla-hero h1{font-family:'Baloo 2',sans-serif;font-size:clamp(34px,10vw,52px);color:var(--maroon);}
	.mezcla-hero .accent{width:60px;height:4px;background:var(--mustard);margin:14px auto;border-radius:4px;}
	.mezcla-hero p{font-size:16px;color:var(--ink);font-weight:600;margin-bottom:24px;}
	.mezcla-hero img{border-radius:20px;box-shadow:0 20px 40px rgba(107,23,48,0.2);max-width:100%;}

	.cta-banner{background:#F4C9CE;text-align:center;padding:44px 20px;}
	.cta-banner h2{font-family:'Baloo 2',sans-serif;font-size:24px;color:var(--maroon);}
	.cta-banner p{margin-top:8px;font-size:14.5px;color:#5a4145;}

	@media (min-width:760px){
		.mezcla-hero{padding:64px 32px 56px;}
		.mezcla-hero .wrap{display:grid;grid-template-columns:0.9fr 1.1fr;text-align:left;align-items:center;gap:48px;}
		.mezcla-hero .accent{margin:14px 0;}
	}
</style>
