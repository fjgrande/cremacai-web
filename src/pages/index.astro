---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import PatternBand from "../components/PatternBand.astro";
import ProductGrid from "../components/ProductGrid.astro";
import FeaturesRow from "../components/FeaturesRow.astro";
import Location from "../components/Location.astro";
import Footer from "../components/Footer.astro";
import { products, location } from "../data/site";
---

<Layout
	title="Cremaçai — Açaí y Gelato Artesanal en Barcelona"
	description="Cremaçai (Cremacai): açaí, gelato artesanal, bowls y shakes en Barcelona. Visítanos en Carrer d'Aragó 303."
>
	<Header />

	<Hero
		imageSrc="/assets/hero-principal.jpg"
		imageAlt="Paltaçaí cremaçai con chocolate, flor comestible y decoración de rosa"
	/>

	<ProductGrid products={products} />

	<PatternBand />

	<FeaturesRow />

	<Location info={location} />

	<Footer />
</Layout>
