---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import PatternBand from "../components/PatternBand.astro";
import ProductGrid from "../components/ProductGrid.astro";
import Builder from "../components/Builder.astro";
import FeaturesRow from "../components/FeaturesRow.astro";
import Location from "../components/Location.astro";
import Footer from "../components/Footer.astro";
import { products, location } from "../data/site";
---

<Layout title="Cremaçai — Gelats i sorbets artesanals">
	<Header />

	<Hero
		imageSrc="/assets/producto-real.jpg"
		imageAlt="Bowlaçaí cremaçai con toppings, chocolate y flor comestible"
	/>

	<ProductGrid products={products} />

	<Builder />

	<PatternBand />

	<FeaturesRow />

	<Location info={location} />

	<Footer />
</Layout>
