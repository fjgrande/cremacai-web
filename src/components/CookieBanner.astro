<div
  class="cookie-banner"
  id="cookieBanner"
  hidden
  role="dialog"
  aria-label="Preferencias de cookies"
>
  <div class="cookie-content">
    <div class="cookie-text">
      <strong>Tu privacidad importa</strong>

      <p>
        Utilizamos cookies opcionales para analizar el uso de la web, medir
        nuestras campañas y personalizar publicidad. Puedes aceptarlas o
        rechazarlas.
      </p>
    </div>

    <div class="cookie-actions">
      <button
        type="button"
        class="cookie-btn cookie-btn-secondary"
        id="rejectCookies"
      >
        Rechazar
      </button>

      <button
        type="button"
        class="cookie-btn cookie-btn-primary"
        id="acceptCookies"
      >
        Aceptar
      </button>
    </div>
  </div>
</div>

<script is:inline>
  (function () {
    const STORAGE_KEY = "cremacai_cookie_consent";

    const banner = document.getElementById("cookieBanner");
    const acceptButton = document.getElementById("acceptCookies");
    const rejectButton = document.getElementById("rejectCookies");

    /**
     * Envía la actualización a Google Consent Mode v2.
     *
     * granted = true
     * → todos los consentimientos concedidos.
     *
     * granted = false
     * → todos los consentimientos rechazados.
     */
    function updateGoogleConsent(granted) {
      window.dataLayer = window.dataLayer || [];

      window.gtag =
        window.gtag ||
        function () {
          window.dataLayer.push(arguments);
        };

      window.gtag("consent", "update", {
        ad_storage: granted ? "granted" : "denied",
        analytics_storage: granted ? "granted" : "denied",
        ad_user_data: granted ? "granted" : "denied",
        ad_personalization: granted ? "granted" : "denied",
      });
    }

    /**
     * Oculta el banner.
     */
    function hideBanner() {
      if (banner) {
        banner.hidden = true;
      }
    }

    /**
     * ACEPTAR
     */
    acceptButton?.addEventListener("click", function () {
      localStorage.setItem(STORAGE_KEY, "accepted");

      updateGoogleConsent(true);

      hideBanner();
    });

    /**
     * RECHAZAR
     */
    rejectButton?.addEventListener("click", function () {
      localStorage.setItem(STORAGE_KEY, "rejected");

      updateGoogleConsent(false);

      hideBanner();
    });

    /**
     * Si todavía no ha elegido nada,
     * mostramos el banner.
     */
    const savedConsent = localStorage.getItem(STORAGE_KEY);

    if (!savedConsent && banner) {
      banner.hidden = false;
    }
  })();
</script>

<style>
  .cookie-banner {
    position: fixed;
    left: 16px;
    right: 16px;
    bottom: calc(16px + env(safe-area-inset-bottom));
    z-index: 9999;

    max-width: 520px;
    margin: 0 auto;

    background: #fffaf2;
    border: 1px solid rgba(107, 23, 48, 0.15);
    border-radius: 16px;

    box-shadow: 0 8px 30px rgba(0, 0, 0, 0.12);

    padding: 16px;
  }

  .cookie-banner[hidden] {
    display: none;
  }

  .cookie-content {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cookie-text strong {
    display: block;
    margin-bottom: 5px;

    color: var(--maroon, #6b1730);
    font-size: 15px;
  }

  .cookie-text p {
    margin: 0;

    color: #554b45;
    font-size: 12.5px;
    line-height: 1.5;
  }

  .cookie-actions {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .cookie-btn {
    min-height: 42px;

    padding: 10px 14px;

    border-radius: 10px;
    border: 1px solid var(--maroon, #6b1730);

    font-family: inherit;
    font-weight: 600;
    font-size: 13px;

    cursor: pointer;
  }

  .cookie-btn-primary {
    background: var(--maroon, #6b1730);
    color: white;
  }

  .cookie-btn-secondary {
    background: transparent;
    color: var(--maroon, #6b1730);
  }

  @media (min-width: 760px) {
    .cookie-banner {
      left: auto;
      right: 24px;
      bottom: 24px;

      width: 420px;

      margin: 0;
    }
  }
</style>
