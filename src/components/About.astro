---
import type { Feature } from "../data/types";

interface Props {
  features: Feature[];
  imageSrc: string;
  imageAlt: string;
}

const { features, imageSrc, imageAlt } = Astro.props;
---

<section class="about" id="nosotros">
  <div class="wrap grid">
    <div>
      <p class="eyebrow">Nuestra receta</p>
      <h2>Cada cucharada, una mezcla</h2>
      <p>
        En cremaçai combinamos açaí, fruta fresca y toppings artesanales para
        crear bowls y helados que se preparan al momento, sin conservantes ni
        atajos. Cada capa está pensada para sorprender: crujiente, cremoso y
        fresco a la vez.
      </p>
      <ul>
        {
          // "feature.color" solo puede ser "maroon" | "mustard" | "green" | "blue"
          // gracias al union type DotColor. Eso es lo que hace que la clase
          // `dot-${feature.color}` de abajo sea segura: no hay forma de que
          // llegue un valor inesperado que rompa el CSS.
          features.map((feature) => (
            <li>
              <span class={`dot dot-${feature.color}`} />
              {feature.label}
            </li>
          ))
        }
      </ul>
    </div>
    <img class="product" src={imageSrc} alt={imageAlt} />
  </div>
</section>

<style>
  .about {
    padding: 100px 24px;
  }
  .about .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 64px;
    align-items: center;
  }
  .about img.product {
    border-radius: 24px;
    box-shadow: 0 20px 40px rgba(107, 23, 48, 0.15);
    max-height: 520px;
    margin: 0 auto;
  }
  .about .eyebrow {
    color: var(--green);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }
  .about h2 {
    font-size: 38px;
    color: var(--maroon);
    margin: 14px 0 20px;
  }
  .about p {
    font-size: 16px;
    color: #4a3a3e;
    max-width: 460px;
  }
  .about ul {
    margin-top: 28px;
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .about ul li {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
    font-weight: 500;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    flex: none;
  }
  .dot-maroon {
    background: var(--maroon);
  }
  .dot-mustard {
    background: var(--mustard);
  }
  .dot-green {
    background: var(--green);
  }
  .dot-blue {
    background: var(--blue);
  }

  @media (max-width: 840px) {
    .about {
      padding: 56px 20px;
    }
    .about .grid {
      grid-template-columns: 1fr;
    }
    .about img.product {
      order: -1;
      max-height: 380px;
    }
  }
  @media (max-width: 600px) {
    .about h2 {
      font-size: 28px;
    }
  }
</style>
