---
import { navLinks, instagramUrl } from "../data/site";

const year = new Date().getFullYear();
---

<footer>
	<div class="wrap">
		<div>
			<div class="logo-word">cremaçai</div>
			<div class="slogan">La vida sabe mejor cuando se mezcla.</div>
		</div>
		<ul>
			{navLinks.map((link) => (
				<li><a href={link.href}>{link.label}</a></li>
			))}
		</ul>
		<div class="socials">
			<a href={instagramUrl} aria-label="Instagram" target="_blank" rel="noopener">
				<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
					<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/>
					<circle cx="17.3" cy="6.7" r="1.1" fill="#fff" stroke="none"/>
				</svg>
			</a>
		</div>
	</div>
	<div class="bottom">© {year} cremaçai. Todos los derechos reservados.</div>
</footer>

<style>
	footer{background:var(--maroon);color:var(--cream-2);padding:28px 20px;text-align:center;}
	footer .logo-word{font-family:'Baloo 2',sans-serif;color:var(--cream);font-size:19px;}
	footer .slogan{font-size:11.5px;margin-top:2px;color:var(--cream-2);}
	footer ul{list-style:none;display:flex;flex-direction:column;gap:8px;margin:18px 0;}
	footer ul li a{font-size:13px;font-weight:500;}
	footer .socials{display:flex;gap:14px;justify-content:center;}
	footer .socials a{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,0.12);display:flex;align-items:center;justify-content:center;}
	footer .bottom{margin-top:18px;font-size:11px;opacity:0.7;}

	@media (min-width:760px){
		footer{padding:32px}
		footer .wrap{display:flex;justify-content:space-between;align-items:center;text-align:left;}
		footer ul{flex-direction:row;gap:24px;margin:0;}
		footer .socials{margin:0;}
	}
</style>
