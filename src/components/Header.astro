---
import { navLinks } from "../data/site";
---

<header>
  <nav class="wrap">
    <span class="logo-word">cremaçai</span>
    <ul>
      {
        navLinks.map((link) => (
          <li>
            <a href={link.href}>{link.label}</a>
          </li>
        ))
      }
    </ul>
    <div class="lang-switch">
      <a href="#">ES</a><span>·</span><a href="#">CA</a><span>·</span><a
        href="#">EN</a
      ><span>·</span><a href="#">PT</a>
    </div>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: var(--cream);
    border-bottom: 1px solid rgba(107, 23, 48, 0.12);
  }
  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 14px 24px;
  }
  nav .logo-word {
    font-size: 26px;
    color: var(--maroon);
  }
  nav ul {
    display: flex;
    gap: 32px;
    list-style: none;
  }
  nav ul li a {
    font-size: 15px;
    font-weight: 500;
    color: var(--ink);
  }
  nav ul li a:hover {
    color: var(--maroon);
  }
  .lang-switch {
    display: flex;
    gap: 8px;
    font-size: 13px;
    font-weight: 500;
    color: var(--maroon);
  }
  .lang-switch span {
    opacity: 0.45;
    cursor: default;
  }

  @media (max-width: 840px) {
    nav ul {
      display: none;
    }
  }
  @media (max-width: 600px) {
    nav {
      padding: 12px 20px;
    }
    nav .logo-word {
      font-size: 22px;
    }
    .lang-switch {
      font-size: 12px;
      gap: 6px;
    }
  }
</style>
