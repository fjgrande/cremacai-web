---
interface Props {
  eyebrow?: string;
  title: string;
  tagline: string;
  imageSrc: string;
  imageAlt: string;
}

const {
  eyebrow = "Gelats i sorbets artesanals",
  title,
  tagline,
  imageSrc,
  imageAlt,
} = Astro.props;
---

<section class="hero">
  <div class="wrap">
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1>{title}</h1>
      <p class="tagline">{tagline}</p>
      <div class="ctas">
        <a href="#ubicacion" class="btn btn-primary">Ver ubicación</a>
        <a href="#nosotros" class="btn btn-outline">Descubre la carta</a>
      </div>
    </div>
    <div class="visual">
      <img src={imageSrc} alt={imageAlt} />
    </div>
  </div>
</section>

<style>
  .hero {
    background: var(--maroon);
    color: var(--cream);
    padding: 72px 24px 96px;
    overflow: hidden;
  }
  .hero .wrap {
    display: grid;
    grid-template-columns: 1.1fr 0.9fr;
    gap: 40px;
    align-items: center;
  }
  .hero .eyebrow {
    font-size: 14px;
    letter-spacing: 2px;
    text-transform: uppercase;
    color: var(--mustard);
    font-weight: 600;
    margin-bottom: 18px;
  }
  .hero h1 {
    font-size: clamp(48px, 7vw, 88px);
    color: var(--cream);
    line-height: 0.95;
  }
  .hero p.tagline {
    margin-top: 22px;
    font-size: 19px;
    font-weight: 300;
    color: var(--cream-2);
    max-width: 460px;
  }
  .hero .ctas {
    margin-top: 40px;
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }
  .hero .visual {
    position: relative;
    display: flex;
    justify-content: center;
  }
  .hero .visual::before {
    content: "";
    position: absolute;
    width: 280px;
    height: 280px;
    background: var(--mustard);
    border-radius: 50%;
    opacity: 0.18;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }
  .hero .visual img {
    position: relative;
    z-index: 1;
    max-width: 340px;
    width: 100%;
    border-radius: 20px;
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.35);
    transform: rotate(3deg);
  }

  @media (max-width: 840px) {
    .hero .wrap {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .hero .copy .tagline {
      margin-left: auto;
      margin-right: auto;
    }
    .hero .ctas {
      justify-content: center;
    }
    .hero .visual {
      order: -1;
      margin-bottom: 8px;
    }
    .hero .visual img {
      max-width: 260px;
    }
  }
  @media (max-width: 600px) {
    .hero {
      padding: 48px 20px 64px;
    }
    .hero h1 {
      font-size: clamp(40px, 15vw, 56px);
    }
    .hero p.tagline {
      font-size: 16px;
    }
    .hero .ctas {
      flex-direction: column;
      width: 100%;
    }
    .hero .ctas .btn {
      text-align: center;
    }
    .hero .visual img {
      max-width: 220px;
    }
  }
</style>
