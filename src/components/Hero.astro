---
import { instagramUrl } from "../data/site";

interface Props {
	imageSrc: string;
	imageAlt: string;
}

const { imageSrc, imageAlt } = Astro.props;
---

<section class="hero">
	<div class="blob" style="width:180px;height:180px;background:var(--mustard);top:-60px;right:-60px;"></div>
	<div class="wrap">
		<div class="copy">
			<h1>La vida sabe mejor cuando se mezcla.</h1>
			<p class="tagline">Açaí, gelato artesanal y combinaciones únicas que te transportan.</p>
			<div class="ctas">
				<a href="#menu" class="btn btn-maroon">Ver nuestro menú →</a>
				<a href={instagramUrl} class="follow" target="_blank" rel="noopener">
					<span class="icon-badge">
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2">
							<rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4"/>
							<circle cx="17.3" cy="6.7" r="1.1" fill="#fff" stroke="none"/>
						</svg>
					</span>
					¡Síguenos en Instagram!
				</a>
			</div>
		</div>
		<div class="visual">
			<img src={imageSrc} alt={imageAlt} />
			<img src={imageSrc} alt={imageAlt} />
		</div>
	</div>
</section>

<style>
	.hero{position:relative;padding:44px 20px 56px;overflow:hidden;}
	.hero .blob{position:absolute;border-radius:50%;opacity:0.9;z-index:0;}
	.hero .wrap{position:relative;z-index:1;}
	.hero h1{font-size:clamp(32px,8.5vw,42px);color:var(--maroon);line-height:1.08;}
	.hero p.tagline{margin-top:14px;font-size:15px;color:#5a4145;max-width:420px;}
	.hero .ctas{margin-top:22px;display:flex;flex-direction:column;gap:16px;align-items:flex-start;}
	.hero .follow{display:flex;align-items:center;gap:8px;font-size:14px;font-weight:600;color:var(--ink);}
	.hero .icon-badge{width:32px;height:32px;border-radius:9px;background:linear-gradient(45deg,#f9ce34,#ee2a7b,#6228d7);display:flex;align-items:center;justify-content:center;}
	.hero .visual{margin-top:32px;display:flex;gap:14px;justify-content:center;}
	.hero .visual img{width:48%;border-radius:18px;box-shadow:0 20px 40px rgba(107,23,48,0.25);}
	.hero .visual img:first-child{margin-top:24px;}

	@media (min-width:760px){
		.hero{padding:64px 32px 80px;}
		.hero .wrap{display:grid;grid-template-columns:1.05fr 0.95fr;gap:40px;align-items:center;}
		.hero .ctas{flex-direction:row;align-items:center;}
		.hero .visual{margin-top:0;}
		.hero .visual img{width:46%;}
		.hero h1{font-size:52px;}
	}
</style>
