---
import type { LocationInfo } from "../data/types";

interface Props {
	info: LocationInfo;
}

const { info } = Astro.props;
---

<section class="location" id="ubicacion">
	<div class="wrap">
		<div class="storefront-card">
			<img src={info.storefrontImage} alt={info.storefrontAlt} />
		</div>
		<div class="location-card">
			<div class="info">
				<h3>Ven a visitarnos</h3>
				<div class="row">
					<span class="ico">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 2C7.6 2 4 5.6 4 10c0 6 8 12 8 12s8-6 8-12c0-4.4-3.6-8-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
						</svg>
					</span>
					<span>{info.address}</span>
				</div>
				<div class="row">
					<span class="ico">
						<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 3"/>
						</svg>
					</span>
					<span>{info.hours}</span>
				</div>
				{info.phone && (
					<div class="row"><span>{info.phone}</span></div>
				)}
				<a href={info.directionsHref} class="btn btn-mustard" target="_blank" rel="noopener">
					<svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor">
						<path d="M12 2C7.6 2 4 5.6 4 10c0 6 8 12 8 12s8-6 8-12c0-4.4-3.6-8-8-8zm0 11a3 3 0 1 1 0-6 3 3 0 0 1 0 6z"/>
					</svg>
					Cómo Llegar
				</a>
			</div>
			<div class="map-wrap">
				<iframe
					src={info.mapEmbedSrc}
					loading="lazy"
					referrerpolicy="strict-origin-when-cross-origin"
					allowfullscreen
				></iframe>
			</div>
		</div>
	</div>
</section>

<style>
	.location{padding:0 20px 52px;}
	.storefront-card{border-radius:16px;overflow:hidden;height:150px;margin-bottom:14px;box-shadow:0 10px 24px rgba(107,23,48,0.15);}
	.storefront-card img{width:100%;height:100%;object-fit:cover;}
	.location-card{background:var(--maroon-dark);color:var(--cream);border-radius:20px;overflow:hidden;box-shadow:0 20px 40px rgba(0,0,0,0.2);}
	.location-card .info{padding:32px 24px;}
	.location-card h3{font-family:'Baloo 2',sans-serif;font-size:19px;margin-bottom:16px;}
	.location-card .row{display:flex;gap:12px;margin-bottom:12px;font-size:14px;align-items:flex-start;}
	.location-card .row .ico{flex:none;width:20px;color:var(--mustard);}
	.location-card .btn{margin-top:16px;}
	.map-wrap{position:relative;height:220px;}
	.map-wrap iframe{width:100%;height:100%;border:0;filter:saturate(0.9);}

	@media (min-width:760px){
		.location{padding:0 32px 80px;}
		.location .wrap{display:grid;grid-template-columns:220px 1fr;gap:24px;align-items:start;}
		.storefront-card{height:100%;margin-bottom:0;}
		.location-card{display:grid;grid-template-columns:1fr 1.2fr;}
		.location-card .info{padding:40px;}
		.map-wrap{height:100%;min-height:320px;}
	}
</style>
